[alias]
	br = branch
	co = checkout

	df = diff --ignore-all-space
	dfc = diff --cached --ignore-all-space
	dfs = -c delta.side-by-side=true diff --ignore-all-space
	dfcs = -c delta.side-by-side=true diff --cached --ignore-all-space
	dfw = diff 
	dfcw = diff --cached 
	dfsw = -c delta.side-by-side=true diff 
	dfcsw = -c delta.side-by-side=true diff --cached 

	glog = log --graph
	grlog = log --graph --pretty=reference
	gslog = log --graph --pretty=format:'%C(auto)SHA:     %H %d%nAuthor:  %aN <%aE>%nDate:    %ad%nSubject: %s%n'
	lcb = log -1 --pretty=format:'%b'
	lcs = log -1 --pretty=format:'%s'
	rlog = log --pretty=reference
	slog = log --pretty=format:'%C(auto)SHA:     %H %d%nAuthor:  %aN <%aE>%nDate:    %ad%nSubject: %s%n'

	showc = -c delta.side-by-side=true show

	st = status

[core]
    pager = delta

[delta]
    navigate = true
    dark = true

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictStyle = diff3
