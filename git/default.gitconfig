[alias]
	br = branch
	co = checkout

	df = diff --ignore-all-space
	dfc = diff --cached --ignore-all-space
	dfs = "!f() { echo git dfs requires delta 1>&2; }; f"
	dfcs = "!f() { echo git dfcs requires delta 1>&2; }; f"
	dfw = diff
	dfcw = diff --cached
	dfsw = "!f() { echo git dfsw requires delta 1>&2; }; f"
	dfcsw = "!f() { echo git dfcsw requires delta 1>&2; }; f"

	glog = log --graph
	grlog = log --graph --pretty=reference
	gslog = log --graph --pretty=format:'%C(auto)SHA:     %H %d%nAuthor:  %aN <%aE>%nDate:    %ad%nSubject: %s%n'
	lcb = log -1 --pretty=format:'%b'
	lcs = log -1 --pretty=format:'%s'
	rlog = log --pretty=reference
	slog = log --pretty=format:'%C(auto)SHA:     %H %d%nAuthor:  %aN <%aE>%nDate:    %ad%nSubject: %s%n'

	shows = "!f() { echo git shows requires delta 1>&2; }; f"

	st = status

[merge]
	conflictStyle = diff3

